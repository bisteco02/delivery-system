# 🔧 CONFIGURAÇÃO DO AMBIENTE
# Copie este arquivo para .env e preencha os valores

# Porta do servidor (Umbler usa variável PORT automaticamente)
PORT=3001

# Porta do WhatsApp Server
WHATSAPP_PORT=8000

# API Key do WhatsApp Local
WHATSAPP_API_KEY=padoca-local-2026

# Ambiente (development, production)
NODE_ENV=production

# URL base do site (será fornecida pela Umbler)
# BASE_URL=https://seu-dominio.umbler.net

# Configurações do banco (SQLite por padrão)
# DATABASE_PATH=./database.db
